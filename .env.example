# Public site URL used for canonical links, the sitemap and Open Graph.
# Falls back to https://varasena.com when unset.
NEXT_PUBLIC_SITE_URL=https://varasena.com

# Google Analytics 4 measurement ID. Leave empty to keep analytics off.
# The script loads only after a visitor accepts analytics in Cookie settings.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX

# SMTP delivery for /api/contact.
# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL / SMTP_PORT fall back to static defaults
# (info@varasena.com and 587) when unset. SMTP_HOST, SMTP_USER and SMTP_PASS
# must still be set for real email delivery.
# Port 465 uses a secure connection. Other ports, including 587, use STARTTLS.
# If SMTP is missing, the form still accepts the enquiry, logs it, and explains
# that delivery is not configured. It does not crash.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@varasena.com
CONTACT_FROM_EMAIL=info@varasena.com

# Optional. POST the enquiry as JSON to this http(s) URL.
# Use it for n8n, a CRM, Google Sheets, or a WhatsApp gateway.
CONTACT_WEBHOOK_URL=

# MySQL. Used to store contact enquiries. No credentials belong in source code.
# If these are missing or the server is down, the form still tries email and the webhook.
# MYSQL_DATABASE defaults to varasena when empty.
#
# Local PC:           MYSQL_HOST=localhost (or 127.0.0.1)
# Hostinger Node.js:  MYSQL_HOST=127.0.0.1
#   Do not put the database name (u680336741_…) in MYSQL_HOST.
#   MYSQL_USER and MYSQL_DATABASE are the full Hostinger names.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=varasena
MYSQL_MAX_CONNECTIONS=20
MYSQL_IDLE_TIMEOUT=300000

# Admin panel at /admin. The first sign-in creates this user when admin_users is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-to-a-long-random-string
