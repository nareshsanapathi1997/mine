# Public site URL used for canonical links, the sitemap and Open Graph.
# Falls back to https://varasena.com when unset.
NEXT_PUBLIC_SITE_URL=https://varasena.com

# Hostinger Node.js build. Optional. The npm build script already caps heap at 2GB.
# NODE_OPTIONS=--max-old-space-size=2048

# Google Analytics 4 measurement ID. Leave empty to keep analytics off.
# The script loads only after a visitor accepts analytics in Cookie settings.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX

# Optional public profiles for footer + schema.org sameAs (only set real URLs).
# NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://maps.google.com/?cid=...
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@...
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/...

# SMTP delivery for /api/contact.
# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL / SMTP_PORT fall back to static defaults
# (info@varasena.com and 587) when unset. SMTP_HOST, SMTP_USER and SMTP_PASS
# must still be set for real email delivery.
# Port 465 uses a secure connection. Other ports, including 587, use STARTTLS.
# If SMTP is missing, the form still accepts the enquiry, logs it, and explains
# that delivery is not configured. It does not crash.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=info@varasena.com
CONTACT_FROM_EMAIL=info@varasena.com

# Optional. POST the enquiry as JSON to this http(s) URL.
# Use it for n8n, a CRM, Google Sheets, or a WhatsApp gateway.
CONTACT_WEBHOOK_URL=

# MySQL. Used to store contact enquiries. No credentials belong in source code.
# If these are missing or the server is down, the form still tries email and the webhook.
# MYSQL_DATABASE defaults to varasena when empty.
#
# Local PC:           MYSQL_HOST=localhost (or 127.0.0.1)
# Hostinger Node.js:  MYSQL_HOST=127.0.0.1
#   Do not put the database name (u680336741_…) in MYSQL_HOST.
#   MYSQL_USER and MYSQL_DATABASE are the full Hostinger names.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=varasena
MYSQL_MAX_CONNECTIONS=20
MYSQL_IDLE_TIMEOUT=300000

# Admin panel at /admin. The first sign-in creates this user when admin_users is empty.
# In production ADMIN_PASSWORD must be 12+ characters and not a default/common value,
# or the account is not created. Change it from /admin/account after the first sign-in.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Required in production: at least 32 random characters. Without it admin sign-in is off.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
# Set to 0 only when testing the panel over plain http on a non-local host.
# ADMIN_COOKIE_SECURE=0

# Admin uploads (logos, page photos). Put this OUTSIDE the app folder in production
# so a redeploy does not delete the files. Defaults to ./storage/uploads.
# UPLOAD_DIR=/home/USER/varasena-uploads

# Client IP detection for rate limits.
# TRUSTED_PROXY_HOPS = number of proxies in front of Node that append to X-Forwarded-For.
#   1 (default) suits Hostinger / a single nginx. Use 2 if Cloudflare sits in front of that.
#   Do not use 0: the app cannot see the socket IP, so every visitor would share one limit.
# CLIENT_IP_HEADER = a header your edge sets to the single real client IP, e.g. cf-connecting-ip.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Website chat assistant (/api/chat) via OpenRouter. Without a key the widget
# replies that the assistant is busy and offers WhatsApp / call instead.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-2-9b-it:free
# Comma-separated models tried in order when the primary fails or is rate-limited.
# OPENROUTER_FALLBACK_MODELS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Seconds per model attempt (minimum 5).
# OPENROUTER_TIMEOUT=30

# Escape hatch: skip the TypeScript check during `next build`. Leave unset.
# SKIP_TYPECHECK=1
