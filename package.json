{
  "name": "varasena-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for VARASENA Technologies, a B2B software and AI company.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 6001",
    "build": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "db:create": "node scripts/db.mjs create",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed-cms": "npx --yes tsx scripts/seed-cms.ts",
    "db:setup": "node scripts/db.mjs setup && npx --yes tsx scripts/seed-cms.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
